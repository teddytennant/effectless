#!/bin/sh
# Stand-in `claude` for process-failure tests. FAKE_MODE: crash | garbage | hang | ok.
if [ "$1" = "--version" ]; then echo "2.1.332 (Claude Code)"; exit 0; fi
case " $* " in
  *" --resume "*)
    if [ "$FAKE_MODE" = "resume_missing" ]; then
      echo "No conversation found with session ID: gone" >&2
      echo '{"type":"result","subtype":"error_during_execution","is_error":true,"errors":[]}'
      exit 1
    fi ;;
esac
sid=$(printf '%s\n' " $* " | sed -n 's/.* --\(session-id\|resume\) \([^ ]*\) .*/\2/p')
while IFS= read -r line; do
  rid=$(printf '%s\n' "$line" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
  case "$line" in
    *'"subtype":"initialize"'*)
      echo "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$rid\",\"response\":{\"commands\":[],\"account\":{\"email\":\"user@example.com\",\"subscriptionType\":\"max\",\"apiProvider\":\"firstParty\"}}}}" ;;
    *'"type":"user"'*)
      echo "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"$sid\",\"model\":\"claude-haiku-5-5\"}"
      echo '{"type":"stream_event","event":{"type":"message_start","message":{"id":"msg_f","model":"claude-haiku-5-5","usage":{"input_tokens":1,"output_tokens":1}}},"parent_tool_use_id":null}'
      echo '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}},"parent_tool_use_id":null}'
      echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"partial"}},"parent_tool_use_id":null}'
      case "$FAKE_MODE" in
        crash) echo "error: fake claude crashed" >&2; exit 1 ;;
        garbage) echo "<<not json>>" ;;
        hang) ;;
        *)
          echo '{"type":"stream_event","event":{"type":"content_block_stop","index":0},"parent_tool_use_id":null}'
          echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"partial\",\"session_id\":\"$sid\",\"usage\":{\"input_tokens\":1,\"output_tokens\":1},\"terminal_reason\":\"completed\"}" ;;
      esac ;;
  esac
done
